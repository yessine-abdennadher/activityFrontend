{
  "expo": {
    "name": "Tfarhida",
    "slug": "tfarhida",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.tfarhida.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tfarhida utilise votre position pour vous recommander les meilleures sorties et loisirs à proximité."
      }
    },
    "android": {
      "package": "tn.tfarhida.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tfarhida utilise votre position pour vous recommander les meilleures sorties et loisirs à proximité."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0F7FF"
        }
      ]
    ]
  }
}
