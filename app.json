{
  "expo": {
    "name": "Win",
    "slug": "win",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F7FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.win.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Win utilise votre position pour vous recommander les activités et loisirs à proximité."
      }
    },
    "android": {
      "package": "tn.win.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Win utilise votre position pour vous recommander les activités et loisirs à proximité."
        }
      ],
      "expo-secure-store"
    ]
  }
}
